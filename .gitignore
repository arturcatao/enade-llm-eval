# e/ou não devem ir para o repositório.
data/
static/

# Resultado gerado pelo pipeline (contém o estado do resume)
resultados.csv
*.csv

# Caso queira versionar algum CSV específico (ex.: um exemplo pequeno),
# reative explicitamente com "!" abaixo, ex.:
# !data/exemplo.csv

# ==================================================
# Logs
