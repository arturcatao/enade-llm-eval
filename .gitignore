.env
.env.*
!.env.example

# ==================================================
# Python
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Empacotamento / instalação
build/
dist/
*.egg-info/
.eggs/

# ==================================================
# Dados e resultados do projeto
# ==================================================
